{
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "description": "The Prove-It Clock \u2014 evidence-driven crypto accountability. Measures the distance between crypto's promises and reality.",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "name": "prove-it-clock",
  "private": true,
  "scripts": {
    "build": "next build",
    "daily": "npm run pipeline && npm run snapshot:load",
    "dev": "next dev",
    "pipeline": "npm run pipeline:ingest && npm run pipeline:score",
    "pipeline:ingest": "tsx src/pipeline/ingest.ts",
    "pipeline:score": "tsx src/pipeline/score.ts",
    "snapshot:load": "tsx scripts/load-snapshot.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "events:check": "tsx scripts/events-check.ts",
    "test:hearts": "node --import tsx --test scripts/hearts.test.ts scripts/case-studies.test.ts"
  },
  "version": "0.1.0"
}

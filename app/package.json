{
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@types/swagger-ui-react": "^5.18.0",
    "driver.js": "^1.8.0",
    "fuse.js": "^7.5.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "4.0.1",
    "swagger-ui-react": "^5.33.0"
  },
  "description": "The Prove-It Clock — evidence-driven crypto accountability. Measures the distance between crypto's promises and reality.",
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "name": "prove-it-clock",
  "private": true,
  "scripts": {
    "build": "next build",
    "daily": "npm run pipeline && npm run snapshot:load",
    "dev": "next dev",
    "pipeline": "npm run pipeline:ingest && npm run pipeline:score",
    "pipeline:ingest": "tsx src/pipeline/ingest.ts",
    "pipeline:score": "tsx src/pipeline/score.ts",
    "snapshot:load": "tsx scripts/load-snapshot.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "events:check": "tsx scripts/events-check.ts",
    "test:hearts": "node --import tsx --test scripts/hearts.test.ts scripts/case-studies.test.ts",
    "test:verdict": "node --import tsx --test scripts/verdict.test.ts",
    "hearts:publish": "node --import tsx scripts/publish-hearts.ts",
    "social:collect": "tsx scripts/collect-social.ts",
    "test:social": "node --import tsx --test scripts/social.test.ts",
    "test:db": "node --import tsx --test scripts/heart-database.test.ts"
  },
  "version": "0.1.0"
}
